      </a>
      <i class="bi bi-list toggle-sidebar-btn"></i>
    </div><!-- End Logo -->

  </header><!-- End Header -->

  <!-- ======= Sidebar ======= -->
  <aside id="sidebar" class="sidebar">

    <ul class="sidebar-nav" id="sidebar-nav">

      <li class="nav-item">
        <a class="nav-link " href="/">
          <i class="bi bi-house-door-fill"></i>
          <span>Home</span>
        </a>
      </li><!-- End Home Nav -->

      <li class="nav-item">
        <a class="nav-link " href="/dashboard" style="background-color: #dddd;">
          <i class="bi bi-bar-chart-fill"></i>
          <span>Dashboard</span>
        </a>
      </li><!-- End Dashboard Nav -->

      <li class="nav-item">
        <a class="nav-link " href="/manage">
          <i class="bi bi-folder-fill"></i>
          <span>Student Management</span>
        </a>
      </li><!-- End Dashboard Nav -->

      <li class="nav-item">
        <a class="nav-link " href="/manage/StudentEnroll">
          <i class="bi bi-person-fill-add"></i>
          <span>Enroll Student</span>
        </a>
      </li><!-- End Dashboard Nav -->

    </ul>

  </aside><!-- End Sidebar-->

  <main id="main" class="main">

    <div class="pagetitle">
      <h1>Dashboard</h1>
      <nav>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item active"><a href="/dashboard">Dashboard</a></li>
        </ol>
      </nav>
    </div><!-- End Page Title -->

    <section class="section dashboard">
      <div class="row">

        <!-- Left side columns -->
        <div class="col-lg-12">

          <!-- BAR GRAPH -->
          <div class="col-lg-12">
            <div class="card">
              <div class="card-body">

                <!-- Filter Dropdowns -->
                <div class="filter mb-5" style="margin-right: 100px; display: flex; gap: 10px">
                  <h4 style="margin-top: 5px;">Filter:</h4>

                  <!-- Month dropdown -->
                  <select class="monthSelect form-select" id="monthSelect" style="width: 200px">
                    <% const
                      months=["January","February","March","April","May","June","July","August","September","October","November","December"];
                      %>
                      <% months.forEach((m, idx)=> { %>
                        <option value="<%= idx+1 %>" <%=(idx+1)===(new Date().getMonth()+1) ? "selected" : "" %>>
                          <%= m %>
                        </option>
                        <% }) %>
                  </select>

                  <!-- Year dropdown -->
                  <select class="form-select" id="yearSelect">
                    <% const thisYear=new Date().getFullYear(); %>
                      <option value="<%= thisYear %>" selected>
                        <%= thisYear %>
                      </option>
                      <option value="<%= thisYear-1 %>">
                        <%= thisYear-1 %>
                      </option>
                  </select>
                </div>
              </div>

              <h5 class="card-title" style="margin-left: 30px;">
                Student Enrollment Reports <span>| Data Visualization</span>
              </h5>

              <!-- Bar Chart -->
              <div id="barChart2"></div>

              <%- include("./partials/scripts") %>
                <script>
                  // Initial data from backend
                  const data = JSON.parse(`<%- JSON.stringify(reportData) %>`);
                  const courses = ["BSIT", "BSME", "BSED", "BSN", "BSHM", "BSCRIM"];

                  // Helper: Align data to course list
                  function alignCourse(data, courses) {
                    return courses.map(course => {
                      const found = data.find(item => item.course === course);
                      return found ? found.total : 0;
                    });
                  }

                  // ApexCharts options
                  var options = {
                    series: [{
                      name: "Students",
                      data: alignCourse(data, courses),
                    }],
                    chart: { height: 350, type: "bar" },
                    plotOptions: {
                      bar: {
                        borderRadius: 10,
                        columnWidth: "50%",
                        distributed: true,
                        dataLabels: { position: "top" },
                      },
                    },
                    dataLabels: {
                      enabled: true,
                      offsetY: -20,
                      style: { fontSize: "15px", colors: ["#304758"] },
                    },
                    xaxis: {
                      categories: courses,
                      position: "top",
                      labels: {
                        offsetY: -5,
                        style: { fontSize: "14px", fontFamily: "Arial, sans-serif", fontWeight: 450, colors: ["#304758"] }
                      },
                      axisBorder: { show: false },
                      axisTicks: { show: false },
                    },
                    yaxis: { labels: { show: false } }
                  };

                  var chart = new ApexCharts(document.querySelector("#barChart2"), options);
                  chart.render();

                  // Handle filter change
                  $("#monthSelect, #yearSelect").on("change", function () {
                    const selectedMonth = $("#monthSelect").val();
                    const selectedYear = $("#yearSelect").val();

                    if (selectedMonth && selectedYear) {
                      $.ajax({
                        url: "http://localhost:5000/dashboard",
                        method: "POST",
                        data: { month: selectedMonth, year: selectedYear },
                        dataType: "json",
                        success: (res) => {
                          if (res.success) {
                            const newData = alignCourse(res.data, courses);

                            // ✅ Ensure chart updates even if no results (fill zeros)
                            chart.updateSeries([{ data: newData.length ? newData : Array(courses.length).fill(0) }]);
                          } else {
                            console.error("Backend error:", res.message);
                          }
                        },
                        error: (xhr, status, err) => {
                          console.error("AJAX error:", err);
                        }
                      });
                    }
                  });
                </script>
                <!-- End Bar Chart -->
            </div>
          </div>



          <!-- Pie Chart Body -->
          <div class="col-lg-12">
            <div class="card">
              <div class="card-body">

                <div class="filter mb-5" style="margin-right: 100px; display: flex; gap: 10px">
                  <h4 style="margin-top: 5px;">Filter:</h4>
                  <select class="levelSelect form-select" id="levelSelect" style="width: 200px">
                    <option value="1">1st Year</option>
                    <option value="2">2nd Year</option>
                    <option value="3">3rd Year</option>
                    <option value="4">4th Year</option>
                  </select>

                  <button id="download" style="border: 0; background-color: #dddd;"
                    onmouseover="this.style.backgroundColor='blue'; this.style.color='white';"
                    onmouseout="this.style.backgroundColor='#dddd'; this.style.color='black';">
                    Download Image
                  </button>

                </div>

                <h5 class="card-title">Courses <span>| Total Enrollees per Department</span></h5>

                <!-- Pie Chart -->
                <div id="piechart-courses" style="min-height: 400px;" class="echarts"></div>

                <%- include("./partials/scripts") %>
                  <script>

                    const pieData = JSON.parse(`<%- JSON.stringify(pieData) %>`);

                    var options = {
                      title: {
                        text: '',
                        subtext: '',
                        left: 'center',
                      },
                      tooltip: {
                        trigger: 'item',
                      },
                      legend: {
                        orient: 'vertical',
                        left: 'left'
                      },
                      series: [{
                        name: 'Students',
                        type: 'pie',
                        radius: '90%',
                        data: pieData,
                        emphasis: {
                          itemStyle: {
                            shadowBlur: 10,
                            shadowOffsetX: 0,
                            shadowColor: 'rgba(0, 0, 0, 0.5)',

                          }
                        }
                      }]
                    }

                    var pie = echarts.init(
                      document.querySelector("#piechart-courses")
                    );
                    pie.setOption(options);

                    document.getElementById('download').onclick = function () {
                      var imgURL = pie.getDataURL({
                        type: 'png',
                        pixelRatio: 1,
                        backgroundColor: '#fff'
                      });
                      var link = document.createElement('a');
                      link.href = imgURL;
                      link.download = 'echarts-chart.png';
                      link.click();
                    };

                    $("#levelSelect").on("change", function () {
                      const selectedLevel = $("#levelSelect").val();
                      if (selectedLevel) {
                        $.ajax({
                          url: "http://localhost:5000/dashboard",
                          method: "POST",
                          data: {
                            level: selectedLevel
                          },
                          dataType: "json",
                          success: (res) => {
                            console.log(res.data);

                            const newData = res.data.map(item => ({
                              value: item.total,
                              name: item.course
                            }));

                            pie.setOption({
                              series: [{
                                data: newData
                              }]
                            })
                          }
                        })
                      }
                    });

                  </script>
                  <!-- End Pie Chart -->

              </div>
            </div>

          </div>


        </div><!-- End Left side columns -->
      </div>
    </section>

